table fct_orders
	lineageTag: 1b19ccb8-881b-4f77-b306-f56782fe9042

	measure 'Net Revenue' = SUM(fct_orders[net_revenue])
		formatString: \€#,0;-\€#,0;\€#,0
		lineageTag: fb156460-daaa-4621-9e64-e05e785489ec

	measure 'Gross Sales' = SUM(fct_orders[gross_amount])
		formatString: \€#,0;-\€#,0;\€#,0
		lineageTag: e7c36a54-685e-4aac-b3ca-3b0f582802b4

	measure 'Refunds' = SUM(fct_orders[refund_amount])
		formatString: \€#,0;-\€#,0;\€#,0
		lineageTag: 569d8343-9379-48c6-8316-57fc041b341b

	measure 'Orders' = COUNTROWS(fct_orders)
		formatString: #,0
		lineageTag: eb78be76-ce33-4738-8295-04f57a171b36

	measure 'Customers' = DISTINCTCOUNT(fct_orders[customer_id])
		formatString: #,0
		lineageTag: 71190f60-eff2-4fa8-b304-274b1f870490

	measure 'Avg Order Value' = DIVIDE([Gross Sales], [Orders])
		formatString: \€#,0.00
		lineageTag: 062ef2c2-2a72-4d0c-9ba0-1627bd8be74d

	measure 'Cancel Rate' = DIVIDE(CALCULATE([Orders], fct_orders[status] = "cancelled"), [Orders])
		formatString: 0.0%
		lineageTag: 4cabc116-7771-4b30-b2f6-b235f93c722f

	measure 'Refund Rate' = DIVIDE([Refunds], [Gross Sales])
		formatString: 0.0%
		lineageTag: 46441a9a-8f3f-4717-9fb7-ac87b2143b6f

	column order_id
